                                </clipPath>
                                <clipPath id="clip-path5">
                                    <path id="Path_24" data-name="Path 24" d="M20.082-28.691a.667.667,0,0,1,.942.023.667.667,0,0,1-.023.943l-5.114,4.85H29.208a.667.667,0,0,1,.667.667.667.667,0,0,1-.667.667h-13.3L21-16.691a.667.667,0,0,1,.023.943.665.665,0,0,1-.483.207.663.663,0,0,1-.46-.184l-5.816-5.54a1.323,1.323,0,0,1-.391-.943,1.332,1.332,0,0,1,.4-.954Z" transform="translate(0 44)" />
