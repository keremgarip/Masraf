                                    <path class="background" id="Path_4" data-name="Path 4" d="M-.875-44.875h45.75V.875H-.875Z" transform="translate(0 44)" fill="#ddd" />
                                </g>
                            </g>
                            <g id="Group_6" data-name="Group 6" clip-path="url(#clip-path-5)">
                                <g id="Group_5" data-name="Group 5" clip-path="url(#clip-path-2)">
                                    <path class="line" id="Path_7" data-name="Path 7" d="M8.658-32.958H35.342v12.224H8.658Z" transform="translate(0 44)" fill="#333" />
                                </g>
                            </g>
                            <g id="Group_8" data-name="Group 8" clip-path="url(#clip-path-7)">
                                <g id="Group_7" data-name="Group 7" clip-path="url(#clip-path-2)">
                                    <path class="line" id="Path_10" data-name="Path 10" d="M8.658-27.4H35.342v12.224H8.658Z" transform="translate(0 44)" fill="#333" />
                                </g>
                            </g>
                            <g id="Group_10" data-name="Group 10" clip-path="url(#clip-path-9)">
                                <g id="Group_9" data-name="Group 9" clip-path="url(#clip-path-2)">
                                    <path class="line" id="Path_13" data-name="Path 13" d="M14.378-21.836H35.342V-9.612H14.378Z" transform="translate(0 44)" fill="#333" />
                                </g>
                            </g>
                        </svg>
                    </a>
                </div>
                <nav class="sideNav">
                    <asp:Panel ID="pnlAdmin" runat="server">
                        <ul id="metismenu" class="metismenu">
                            <li id="liAnasayfa" runat="server" class="menu-item">
                                <img src="/img/icons/home.png" alt="" class="navIcon">
                                <a class="noSub" href="default.aspx">Anasayfa</a>
                            </li>
                            <li id="liYonetici" runat="server" class="menu-item">
                                <img src="/img/icons/personnel.png" alt="" class="navIcon">
                                <a class="noSub" href="/masrafyonetici.aspx">Yöneticiler</a>
                            </li>
                            <li id="liPersonel" runat="server" class="menu-item">
                                <img src="/img/icons/personnel.png" alt="" class="navIcon">
                                <a class="noSub" href="/masrafpersonnels.aspx">Personel Listesi</a>
                            </li>
                            <li id="liMasrafGrup" runat="server" class="menu-item">
                                <img src="/img/icons/sorumlu.png" alt="" class="navIcon">
                                <a class="noSub" href="/masrafgruplist.aspx">Masraf Grup Yönetimi</a>
                            </li>
                            <li id="liMasrafFormu" runat="server" class="menu-item">
                                <img src="/img/icons/form.png" alt="" class="navIcon">
                                <a class="noSub" href="/masrafformulist.aspx">Masraf Yönetimi</a>
                            </li>
                            <li id="liGonderilen" runat="server" class="menu-item">
                                <img src="/img/icons/checkmark.png" alt="" class="navIcon">
                                <a class="noSub" href="/masrafgonderilen.aspx">Gönderilen Masraflar</a>
                            </li>
                            <li id="liMasrafOnay" runat="server" class="menu-item">
                                <img src="/img/icons/hourglass.png" alt="" class="navIcon">
                                <a class="noSub" href="/masrafonaylama.aspx">Onay Bekleyen Masraflar</a>
                            </li>
                            <li id="liExcelExport" runat="server" class="menu-item">
                                <img src="/img/icons/excel.png" alt="" class="navIcon">
                                <a class="noSub" href="/exportexcel.aspx">Excel Dışa Aktarma</a>
                            </li>
                        </ul>
                    </asp:Panel>
                </nav>
                <div class="modulePic">
                    <img class="currentModule" src="img/avatar.png" />
                    <div class="form-group">
                        <label class="brandName fs-24"></label>
                    </div>
                </div>
            </aside>
            <section class="right-side">
                <div class="flex alignCenter userDetails print-none">
                    <div id="divUserMenu" class="userNav">
                        <a id="aProfil" class="userName flex alignCenter justifyCenter" onclick="logoutShowHideMenu();"><%= loggedInUserNameStr%></a>
                        <div class="bg-effect"></div>
                        <ul id="ulProfilMenu" class="account-options d-none">
                            <li><a class="logout" href="logout.aspx">
                                <img src="/img/icons/logout.svg" alt="Çıkış">Çıkış</a></li>
                        </ul>
                    </div>
                </div>
                <div id="thinkContent">
                    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
                <div id="formContent">
                </div>
            </section>
        </main>
        <input type="hidden" id="hddnmenu" name="hddnmenu" value="0">

        <script src="dist/app.min.js" asp-append-version="true"></script>
        <script src="js/pages/layout.js" asp-append-version="true"></script>
        <script type="text/javascript" src="js/plugins/blockui/jquery.blockUI.js"></script>
        <style>
            .remove,
            .removeBefore::before {
                display: none;
            }
        </style>

        <script>
            function init() {
                $('.userDetails').addClass('remove');
                $('main').addClass('removeBefore');
                $('aside').addClass('remove');
                $('.contentSticky').css('padding', '0');
            }
            function logoutShowHideMenu() {
                if (document.getElementById("hddnmenu").value == "0") {
                    $('#ulProfilMenu').removeClass('account-options d-none');
                    $('#ulProfilMenu').addClass('account-options d-block');
                    document.getElementById("hddnmenu").value = "1";
                }
                else if (document.getElementById("hddnmenu").value == "1") {
                    $('#ulProfilMenu').removeClass('account-options d-block');
                    $('#ulProfilMenu').addClass('account-options d-none');
                    document.getElementById("hddnmenu").value = "0";
                }
            }
        </script>
    </form>
</body>
</html>
