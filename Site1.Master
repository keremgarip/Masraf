                                    <path id="Path_12" data-name="Path 12" d="M14.771-22.4H29.229a1.112,1.112,0,0,1,1.112,1.112,1.112,1.112,0,0,1-1.112,1.112H14.771a1.112,1.112,0,0,1-1.112-1.112A1.112,1.112,0,0,1,14.771-22.4Z" transform="translate(0 44)" />
