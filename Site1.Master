<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="Masraf.Site1" %>

<!DOCTYPE html>

<html lang="tr">
<head runat="server">
    <meta http-equiv="content-type" content="text/html; charset=utf-8" /> 
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="description" content="" />
    <meta name="author" content="" />
    <title>Masraf Yönetim Paneli</title>
    <script src="https://code.jquery.com/jquery-3.6.1.js" integrity="sha256-3zlB5s2uwoUzrXK3BT7AX3FyvojsraNFxCc2vC/7pNI=" crossorigin="anonymous"></script>
    <link id="twStyle" rel="stylesheet" href="dist/app_skin_sale-light.css?v=1" asp-append-version="true">
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <main class="flex fluid alignStretch justifyStart">
            <aside>
                <a href="/" class="logo">
                    <img src="img/logo.jpg" alt="Logo" class="logoBig" />
                    <img src="img/redcell_logo_small.png" alt="Logo" class="logoSmall" />
                </a>
                <svg class="collapseButtonBack" width="29" height="118" viewBox="0 0 29 118" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M27 16C27 7.16344 19.8366 0 11 0H27H28.5V118H27C27 104.634 19.4399 96.7329 12.3207 89.2928C7.14086 83.8796 2.19441 78.7103 0.56282 71.8571C0.198995 70.3289 0 68.717 0 67C0 57.4555 6.1491 50.8717 12.5783 43.9879C19.6211 36.4472 27 28.5466 27 16Z" fill="#F8F8F8" />
                </svg>
                <div class="collapseButton">
                    <a href="JavaScript:void(0);" class="menu-open">
                        <svg class="openSvg" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="44" height="44" viewBox="0 0 44 44">
                            <defs>
                                <clipPath id="clip-path1">
                                    <path id="Path_18" data-name="Path 18" d="M22,0A22,22,0,0,1,0-22,22,22,0,0,1,22-44,22,22,0,0,1,44-22,22,22,0,0,1,22,0Z" transform="translate(0 44)" clip-rule="evenodd" />
