                                <g id="Group_1" data-name="Group 1" clip-path="url(#clip-path-2)">
                                    <path class="border" id="Path_1" data-name="Path 1" d="M-5-49H49V5H-5Z" transform="translate(0 44)" fill="#333" />
                                </g>
