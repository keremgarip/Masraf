                            </defs>
                            <g data-name="Group 12" clip-path="url(#clip-path1)">
                                <g data-name="Group 11" clip-path="url(#clip-path2)">
                                    <path class="border" data-name="Path 16" d="M-5,5H49V-49H-5Z" transform="translate(0 44)" />
                                </g>
                            </g>
                            <g data-name="Group 14" clip-path="url(#clip-path3)">
                                <g data-name="Group 13" clip-path="url(#clip-path2)">
                                    <path class="background" data-name="Path 19" d="M-.875.875h45.75v-45.75H-.875Z" transform="translate(0 44)" />
                                </g>
                            </g>
                            <g data-name="Group 16" clip-path="url(#clip-path5)">
                                <g data-name="Group 15" clip-path="url(#clip-path2)">
                                    <path class="line" data-name="Path 22" d="M8.875-10.542h26V-33.875h-26Z" transform="translate(0 44)" />
                                </g>
                            </g>
                        </svg>
                    </a>
                    <a href="JavaScript:void(0);" class="menu-closed">
                        <svg class="closeSvg" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="44" height="44" viewBox="0 0 44 44">
                            <defs>
                                <clipPath id="clip-path">
                                    <path id="Path_3" data-name="Path 3" d="M22,0A22,22,0,0,0,44-22,22,22,0,0,0,22-44,22,22,0,0,0,0-22,22,22,0,0,0,22,0Z" transform="translate(0 44)" />
                                </clipPath>
                                <clipPath id="clip-path-2">
                                    <path id="Path_2" data-name="Path 2" d="M-227,976H1213V-90H-227Z" transform="translate(0 44)" />
                                </clipPath>
                                <clipPath id="clip-path-3">
                                    <path id="Path_6" data-name="Path 6" d="M22-39.875A17.875,17.875,0,0,1,39.875-22,17.875,17.875,0,0,1,22-4.125,17.875,17.875,0,0,1,4.125-22,17.875,17.875,0,0,1,22-39.875Z" transform="translate(0 44)" />
                                </clipPath>
                                <clipPath id="clip-path-5">
                                    <path id="Path_9" data-name="Path 9" d="M14.771-27.958H29.229a1.112,1.112,0,0,1,1.112,1.112,1.112,1.112,0,0,1-1.112,1.112H14.771a1.112,1.112,0,0,1-1.112-1.112A1.112,1.112,0,0,1,14.771-27.958Z" transform="translate(0 44)" />
